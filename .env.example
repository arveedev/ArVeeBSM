# Copy this file to .env.local and fill in your Firebase project's values.
# .env.local is gitignored and read automatically by Vite.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Phase 6 — Google Apps Script web app URL for the Sheets logging bridge
VITE_GOOGLE_SHEETS_BRIDGE_URL=

# Dexie Cloud - used ONLY by api/dexie-cloud-tokens.js (server-side,
# never exposed to the browser). Values come from your dexie-cloud.key
# file (created by `npx dexie-cloud create`). In production, set these
# in the Vercel dashboard under Project Settings > Environment
# Variables instead of in a committed file.
DEXIE_CLOUD_DB_URL=https://z15dzktxq.dexie.cloud
DEXIE_CLOUD_CLIENT_ID=
DEXIE_CLOUD_CLIENT_SECRET=
