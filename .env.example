# Copy this file to .env.local and fill in your Firebase project's values.
# .env.local is gitignored and read automatically by Vite.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Phase 6 — Google Apps Script web app URL for the Sheets logging bridge
VITE_GOOGLE_SHEETS_BRIDGE_URL=

# Dexie Cloud - used ONLY by api/dexie-cloud-tokens.js (server-side,
# never exposed to the browser). Values come from your dexie-cloud.key
# file (created by `npx dexie-cloud create`). In production, set these
# in the Vercel dashboard under Project Settings > Environment
# Variables instead of in a committed file.
#
# MUST match src/db/dexie.js's own db.cloud.configure({ databaseUrl })
# exactly - if this doesn't match what the client is actually pointed
# at, every device gets a token for the wrong database and sync fails
# silently (this is the class of bug that LOOKS like "data going
# missing" but is really "never actually synced at all"). This was
# switched on 2026-08-03 (see git commit "Point app at a fresh Dexie
# Cloud database") - the old z15dzktxq database was abandoned because
# its schema history was permanently stuck. If your real Vercel/local
# env var still says z15dzktxq, it was never updated to match and
# needs fixing now.
DEXIE_CLOUD_DB_URL=https://zv432njdm.dexie.cloud
DEXIE_CLOUD_CLIENT_ID=
DEXIE_CLOUD_CLIENT_SECRET=
